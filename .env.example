# Copy to .env (same folder) and fill in. .env is git-ignored: never commit real values.

# config.settings.dev for local development, config.settings.prod for staging/production.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Django's own secret (sessions, CSRF). Long random value, different per environment:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Signs the React app's sign-in and password-reset tokens.
APP_SECRET_KEY=
# TOKEN_TTL_SECONDS=28800
# PASSWORD_RESET_TTL_SECONDS=1800

# Sign-in protection (README: "Sign-in security"). Rates per client IP: <number>/<sec|min|hour|day>.
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=5/hour
# THROTTLE_PASSWORD_RESET=5/hour
# After this many failed sign-ins to one account, its sign-in is refused for LOGIN_LOCKOUT_SECONDS.
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# Behind IIS / nginx set 1, so the client's real address (X-Forwarded-For) is used for the rates above.
# NUM_PROXIES=0
# Self sign-up: false hides "Create one" and refuses new accounts. Domains: comma-separated; empty = any domain.
# ALLOW_REGISTRATION=true
# REGISTRATION_EMAIL_DOMAINS=aiintelekt.com
# Content Security Policy: report-only until this is true (README: "Sign-in security").
# CSP_ENFORCE=false

# MySQL: the existing release-notes database (tables are used as they are).
DB_NAME=react_database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# prod only: comma-separated host names this server answers to, and https origins for CSRF.
# ALLOWED_HOSTS=release-notes.staging.example.com
# CSRF_TRUSTED_ORIGINS=https://release-notes.staging.example.com
# prod only, once the site is https-only: redirect http to https, and send HSTS (seconds).
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# Address people open this Django app at (used in password reset emails).
APP_BASE_URL=http://localhost:8000

# Screenshots live in <UPLOAD_DIR>/release-images/. Default: media/ in this project.
# UPLOAD_DIR=E:/version-project/release_notes/media

# Django Admin (/admin/) is off by default. Set to true to switch it on.
# ENABLE_DJANGO_ADMIN=false

# Email (password reset, release notes). README "Email" has the details.
# EMAIL_MODE: file (save .eml files in MAIL_FILE_DIR, nothing sent) | smtp (send via SMTP_*) | console (print).
# Production: the infrastructure team sets EMAIL_MODE=smtp and the SMTP_* values on the server.
EMAIL_MODE=file
MAIL_FILE_DIR=sent_emails
# MAIL_FROM=iCRM Releases <no-reply@aiintelekt.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TIMEOUT=20

# ---- Live Jira Cloud and Bitbucket Cloud (Dashboard, Jira Tickets, Bitbucket, Commits & PRs) ----
# Server-side only: no API response ever contains these values. Leave a block empty and that integration
# shows "not configured" while the rest of the app keeps working.

# Jira Cloud. JIRA_API_TOKEN: an Atlassian API token (id.atlassian.com > Security > API tokens) of an account that
# can browse the projects below; a read-only service account is best.
JIRA_BASE_URL=https://your-site.atlassian.net
# Token made with "Create API token with scopes" (Jira scopes read:jira-work, optionally read:jira-user):
# set the site's cloud ID, from https://your-site.atlassian.net/_edge/tenant_info, so calls go through the
# Atlassian API gateway. Leave empty for a classic (unscoped) API token.
# JIRA_CLOUD_ID=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=CS,IBP,CT,CP
# Names as they appear in your Jira workflows (checked against Jira; unknown names are ignored and reported).
# JIRA_BUG_ISSUE_TYPES=Bug
# JIRA_RESOLVED_STATUSES=Resolved
# JIRA_CLOSED_STATUSES=Closed,Done
# Projects that finish with a single Done status: JIRA_RESOLVED_STATUSES=Done and JIRA_CLOSED_STATUSES= (empty).
# Release-wise summaries: map app versions to the Jira fix version names, once you've checked them
# (Dashboard > Release-wise tickets lists Jira's actual names). Format: app=Jira name|other name; ...
# JIRA_FIX_VERSION_MAP=10.9=10.9.0|10.9.1;10.8=10.8.0|10.8.5

# Bitbucket Cloud. Either an Atlassian API token with Bitbucket scopes read:repository:bitbucket and
# read:pullrequest:bitbucket (BITBUCKET_EMAIL + BITBUCKET_API_TOKEN), or an access token (BITBUCKET_ACCESS_TOKEN).
BITBUCKET_WORKSPACE=your-workspace
# Comma-separated repository slugs; add more (e.g. sql_group) without code changes.
BITBUCKET_REPOSITORIES=icrm-base-framework-master,icrm-b2b-master
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
# BITBUCKET_ACCESS_TOKEN=

# Seconds per external request, and how long Jira/Bitbucket answers are reused.
# INTEGRATION_TIMEOUT_SECONDS=15
# INTEGRATION_CACHE_SECONDS=300
