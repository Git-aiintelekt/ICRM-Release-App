<?xml version="1.0" encoding="UTF-8"?>
<!-- iCRM Release Notes: read-only release history, generated by the Release Notes Django app.
     Package @@FILE_NAME@@ (latest version @@VERSION@@, generated @@GENERATED_AT@@).
     Do not edit by hand: change the notes in the Django app and generate a new package. -->
<ofbiz-component name="release-notes"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/ofbiz-component.xsd">
    <resource-loader name="main" type="component"/>

    <!-- One-time menu entry + view permission (see README.md). -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/ReleaseNotesSeedData.xml"/>

    <!-- The page (sign-in required): /release-notes/control/main -->
    <webapp name="release-notes"
        title="Release Notes"
        server="default-server"
        location="webapp/release-notes"
        mount-point="/release-notes"/>
    <!-- Viewer code (js, css) and screenshots: static files, like every *-resource webapp. -->
    <webapp name="release-notes-resource"
        title="Release Notes resources (js, css, screenshots)"
        server="default-server"
        location="webapp/release-notes-resource"
        mount-point="/release-notes-resource"
        app-bar-display="false"/>
</ofbiz-component>
