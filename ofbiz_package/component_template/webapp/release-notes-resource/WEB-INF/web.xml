<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0">
    <display-name>iCRM - Release Notes resources</display-name>
    <description>Static files of the Release Notes viewer: js, css and screenshots</description>

    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>
</web-app>
