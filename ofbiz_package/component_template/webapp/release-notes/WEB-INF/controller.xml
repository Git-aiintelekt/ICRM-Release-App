<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/site-conf.xsd">
    <!-- Same includes as the other iCRM portals: common requests and the iCRM sign-in pages. -->
    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>
    <include location="component://common/webcommon/WEB-INF/security-controller.xml"/>
    <include location="component://admin-portal/webapp/admin-portal/WEB-INF/controller.xml"/>
    <description>iCRM Release Notes (read-only, package @@FILE_NAME@@)</description>

    <handler name="ftl" type="view" class="org.ofbiz.webapp.ftl.FreeMarkerViewHandler"/>

    <preprocessor>
        <!-- Signed in to another iCRM app (externalLoginKey in the menu link): signed in here too. -->
        <event type="java" path="org.ofbiz.webapp.control.LoginWorker" invoke="checkExternalLoginKey"/>
    </preprocessor>

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- The release history page: the React viewer with the release data embedded. -->
    <view-map name="main" type="ftl" page="component://release-notes/webapp/release-notes/main.ftl"
        content-type="text/html" encoding="UTF-8"/>
</site-conf>
